{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.v1",
  "title": "Platform request (logical values only, no secrets)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "request_id",
    "name",
    "environment",
    "sizing",
    "image",
    "network_profile"
  ],
  "properties": {
    "contract": {
      "const": "request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}-[0-9]{4,8}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,23}$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "lab",
        "dev",
        "test",
        "prod"
      ]
    },
    "sizing": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "placement": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "network_profile": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "node_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 1
    },
    "data_disk_gb": {
      "type": "integer",
      "minimum": 10,
      "maximum": 2048
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,64}$"
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "change_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,32}$"
    },
    "middleware": {
      "type": "string",
      "enum": [
        "none",
        "jboss"
      ],
      "default": "none"
    },
    "topology": {
      "type": "string",
      "enum": [
        "standalone"
      ],
      "default": "standalone"
    }
  }
}
