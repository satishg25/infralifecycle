{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine_spec.v1",
  "title": "Provider-neutral machine spec (output of machine_resolve, input to compute drivers)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "name", "cpu", "memory_gb", "image_ref", "placement_ref", "network_ref", "disks", "tags"],
  "properties": {
    "contract": {"const": "machine_spec.v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,23}$"},
    "cpu": {"type": "integer", "minimum": 1},
    "memory_gb": {"type": "integer", "minimum": 1},
    "image_ref": {"type": "string"},
    "placement_ref": {"type": "string"},
    "network_ref": {"type": "string"},
    "disks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "size_gb"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z]+$"},
          "size_gb": {"type": "integer", "minimum": 1},
          "mount": {"type": "string"},
          "fs": {"type": "string", "enum": ["xfs", "ext4"]}
        }
      }
    },
    "tags": {"type": "object", "additionalProperties": {"type": "string"}},
    "native": {"type": "object"}
  }
}
